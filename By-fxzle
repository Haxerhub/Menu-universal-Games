local noclipActive = false
local noclipManual = false
local farmActive = false
local flySpeed = 16
local currentTween = nil

local function aplicarNoclip(estado)
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not estado
            part.CanTouch = true
        end
    end
end

local COIN_NAMES = {
    ["Coin"] = true,
    ["CoinDrop"] = true,
    ["CoinContainer"] = true,
    ["Coin_"] = true,
    ["Money"] = true,
    ["Cash"] = true,
}

local function isCoinPart(obj)
    if not obj or not obj:IsA("BasePart") then return false end
    if COIN_NAMES[obj.Name] then return true end
    local lower = obj.Name:lower()
    return lower:find("coin") or lower:find("money") or lower:find("cash")
end

local function findGlobalCoin(hrp)
    local bestCoin, shortestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCoinPart(obj) and obj.Transparency < 1 then
            local dist = (hrp.Position - obj.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                bestCoin = obj
            end
        end
    end
    return bestCoin
end

FarmTab:Section({ Title = "AUTOFARM DE MONEDAS (MM2)", Icon = "coins" })

FarmTab:Toggle({
    Title = "FARM COIN VUELO SEGURO (TWEEN)",
    Icon = "coins",
    Default = false,
    Callback = function(v)
        farmActive = v
        local TweenService = game:GetService("TweenService")
        local lp = game.Players.LocalPlayer
        
        if v then
            noclipActive = true
            aplicarNoclip(true)
            
            task.spawn(function()
                while noclipActive do
                    aplicarNoclip(true)
                    task.wait(0.3)
                end
            end)
            
            task.spawn(function()
                while farmActive do
                    local char = lp.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    
                    if hrp and hum and hum.Health > 0 then
                        hum.PlatformStand = true
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        
                        local coin = findGlobalCoin(hrp)
                        if coin and coin.Parent then
                            local targetPos = CFrame.new(coin.Position + Vector3.new(0, 0.4, 0))
                            local dist = (hrp.Position - targetPos.Position).Magnitude
                            local duration = math.clamp(dist / (flySpeed * 1.5), 0.3, 2.0)
                            
                            if currentTween then
                                pcall(function() currentTween:Cancel() end)
                            end
                            
                            local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                            currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetPos})
                            currentTween:Play()
                            
                            while currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing and farmActive and coin.Parent do
                                hrp.AssemblyLinearVelocity = Vector3.zero
                                task.wait(0.1)
                                if (hrp.Position - targetPos.Position).Magnitude < 3 then break end
                            end
                            
                            if firetouchinterest and coin.Parent then
                                pcall(function()
                                    firetouchinterest(hrp, coin, 0)
                                    task.wait(0.05)
                                    firetouchinterest(hrp, coin, 1)
                                end)
                            end
                        else
                            task.wait(0.5)
                        end
                    else
                        task.wait(0.5)
                    end
                    task.wait(0.1)
                end
                
                if currentTween then
                    pcall(function() currentTween:Cancel() end)
                    currentTween = nil
                end
                local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.PlatformStand = false end
            end)
        else
            if currentTween then
                pcall(function() currentTween:Cancel() end)
                currentTween = nil
            end
            local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
            
            if not noclipManual then
                noclipActive = false
                aplicarNoclip(false)
            end
        end
    end
})

